{
  "manifest_version": 3,
  "name": "Baton",
  "version": "0.1.0",
  "description": "Context handoff across AI chats. Saves chats locally and builds a compact, paste-ready context prompt.",
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Baton",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "options_page": "manager/manager.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://kimi.ai/*",
        "https://www.kimi.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*"
      ],
      "js": ["src/redact.js", "src/extract.js", "src/adapters.js", "src/observer.js"],
      "run_at": "document_idle"
    }
  ]
}
